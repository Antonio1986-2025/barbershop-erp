generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELED
  EXPIRED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum FeatureType {
  BOOLEAN
  NUMBER
  TEXT
}

enum Currency {
  BRL
  USD
  EUR
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum PaymentProviderType {
  MERCADO_PAGO
  STRIPE
  ASAAS
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  TRANSFER
  OTHER
  STORE_CREDIT
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  CANCELED
  REFUNDED
}

enum CashTransactionType {
  ENTRY
  EXIT
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  CONSUMPTION
  ADJUSTMENT
  RETURN
  LOSS
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  RECEIVED
  COMPLETED
  CANCELLED
}

enum InventoryStatus {
  OPEN
  COUNTING
  REVIEW
  APPROVED
  ADJUSTMENTS_GENERATED
  CLOSED
  CANCELLED
}

enum ScheduleBlockType {
  UNIT
  PROFESSIONAL
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialAccountType {
  RECEIVABLE
  PAYABLE
}

enum FinancialAccountStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CashbackStatus {
  PENDING
  AVAILABLE
  USED
  EXPIRED
}

enum SaleStatus {
  DRAFT
  OPEN
  PAID
  CANCELLED
  REFUNDED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  STOCK_LOW
  STOCK_ZERO
  STOCK_NEGATIVE
  STOCK_INACTIVE
  STOCK_EXPIRING
  SALE_COMPLETED
  SALE_CANCELLED
  SALE_REFUNDED
}

enum StockAlertType {
  LOW_STOCK
  ZERO_STOCK
  NEGATIVE_STOCK
  INACTIVE_PRODUCT
  EXPIRING_PRODUCT
}

enum NotificationChannel {
  INTERNAL
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ConversationChannel {
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum IntegrationLogDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationLogStatus {
  SUCCESS
  FAILED
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum CampaignType {
  WHATSAPP
  EMAIL
  SMS
  PUSH
  INTERNAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  VISIT
  NOTE
  SYSTEM
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  FOLLOW_UP
  CALLBACK
  APPOINTMENT
  SALE
  COLLECTION
  REMINDER
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model Plan {
  id String @id @default(uuid())

  code        String  @unique
  name        String
  description String?

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy     String?
  updatedBy     String?
  deletedBy     String?
  planPrices    PlanPrice[]
  planFeatures  PlanFeature[]
  subscriptions Subscription[]

  @@index([active])
  @@index([createdAt])
  @@map("plans")
}

model PlanPrice {
  id String @id @default(uuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  price    Float
  currency Currency @default(BRL)

  billingCycle BillingCycle

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, billingCycle, currency])
  @@map("plan_prices")
}

model Feature {
  id String @id @default(uuid())

  name         String
  code         String      @unique
  description  String?
  type         FeatureType
  defaultValue String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plans PlanFeature[]

  @@map("features")
}

model PlanFeature {
  id String @id @default(uuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id])

  value String

  @@unique([planId, featureId])
  @@map("plan_features")
}

model Subscription {
  id String @id @default(uuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(TRIAL)

  startDate DateTime
  endDate   DateTime?

  canceledAt   DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company?

  @@index([status])
  @@map("subscriptions")
}

model Company {
  id String @id @default(uuid())

  subscriptionId String @unique

  corporateName String
  tradeName     String?

  document String  @unique
  email    String
  phone    String?

  status CompanyStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  subscription     Subscription      @relation(fields: [subscriptionId], references: [id])
  settings         CompanySettings?
  users            User[]
  units            Unit[]
  customers        Customer[]
  professionals    Professional[]
  services         Service[]
  appointments     Appointment[]
  serviceOrders    ServiceOrder[]
  cashRegisters    CashRegister[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  categories       Category[]
  products         Product[]
  auditLogs        AuditLog[]
  businessHours    BusinessHour[]
  scheduleBlocks   ScheduleBlock[]
  notifications    Notification[]
  suppliers        Supplier[]
  purchases        Purchase[]
  sales               Sale[]
  coupons             Coupon[]
  cashbackTransactions CashbackTransaction[]
  loyaltyPrograms     LoyaltyProgram[]
  loyaltyPoints       LoyaltyPoints[]
  customerSegments    CustomerSegment[]
  customerTags        CustomerTag[]
  campaigns           Campaign[]
  customerInteractions CustomerInteraction[]
  customerTasks        CustomerTask[]
  conversations        Conversation[]
  integrations         Integration[]
  stocks              Stock[]
  stockMovements      StockMovement[]
  transfers           Transfer[]
  inventoryCounts     InventoryCount[]
  stockAlerts         StockAlert[]
  financialCategories FinancialCategory[]
  financialAccounts   FinancialAccount[]
  cashClosings        CashClosing[]

  @@index([status])
  @@index([createdAt])
  @@map("companies")
}

model CompanySettings {
  id String @id @default(uuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  logoUrl        String?
  primaryColor   String?
  secondaryColor String?

  displayName   String?
  website       String?
  contactEmail  String?
  contactPhone  String?

  timezone  String?
  currency  String?
  dateFormat String?

  defaultAppointmentDuration Int?
  allowOnlineScheduling      Boolean?
  cancellationLimitHours     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

model User {
  id String @id @default(uuid())

  companyId String

  name         String
  email        String
  passwordHash String

  active Boolean @default(true)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company       Company         @relation(fields: [companyId], references: [id])
  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@unique([email, companyId])
  @@index([companyId])
  @@index([active])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String

  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  description String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([active])
  @@map("roles")
}

model Permission {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  description String?
  module      String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([active])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Unit {
  id String @id @default(uuid())

  companyId String

  name String
  code String

  document String?
  phone    String?
  email    String?

  address      String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?

  status CompanyStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company Company @relation(fields: [companyId], references: [id])

  professionals    ProfessionalUnit[]
  appointments     Appointment[]
  serviceOrders    ServiceOrder[]
  cashRegisters    CashRegister[]
  payments         Payment[]
  cashTransactions CashTransaction[]
  sales            Sale[]
  stocks           Stock[]
  stockMovements   StockMovement[]
  businessHours    BusinessHour[]
  scheduleBlocks   ScheduleBlock[]
  cashClosings     CashClosing[]
  purchases        Purchase[]
  transfersFrom    Transfer[] @relation("transfersFrom")
  transfersTo      Transfer[] @relation("transfersTo")
  inventoryCounts  InventoryCount[]
  stockAlerts      StockAlert[] @relation("UnitStockAlerts")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("units")
}

model BusinessHour {
  id String @id @default(uuid())

  companyId String
  unitId    String

  dayOfWeek Int
  startTime String
  endTime   String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([unitId, dayOfWeek])
  @@index([companyId])
  @@index([unitId])
  @@index([dayOfWeek])
  @@map("business_hours")
}

model ScheduleBlock {
  id String @id @default(uuid())

  companyId      String
  unitId         String
  professionalId String?

  title   String
  reason  String?

  type ScheduleBlockType @default(UNIT)

  startAt DateTime
  endAt   DateTime

  createdBy String

  createdAt DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([companyId])
  @@index([unitId])
  @@index([professionalId])
  @@index([startAt])
  @@map("schedule_blocks")
}

model Notification {
  id String @id @default(uuid())

  companyId String
  userId    String?
  customerId String?

  type    NotificationType
  channel NotificationChannel @default(INTERNAL)

  title   String
  message String

  status NotificationStatus @default(PENDING)

  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?

  metadata String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
  @@map("notifications")
}

model CustomerSegment {
  id String @id @default(uuid())

  companyId String

  name        String
  description String?
  rules       String   // JSON
  color       String?
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id])
  campaigns Campaign[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([active])
  @@map("customer_segments")
}

model Campaign {
  id String @id @default(uuid())

  companyId String
  segmentId String?

  name            String
  description     String?
  type            CampaignType
  status          CampaignStatus @default(DRAFT)
  messageTemplate String?

  scheduledAt DateTime?
  sentAt      DateTime?

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  failedCount     Int @default(0)
  readCount       Int @default(0)

  createdBy  String
  approvedBy String?

  startedAt  DateTime?
  finishedAt DateTime?

  templateVariables String?
  metadata          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  segment  CustomerSegment?   @relation(fields: [segmentId], references: [id])
  recipients CampaignRecipient[]
  interactions CustomerInteraction[]

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  customerId String

  status CampaignRecipientStatus @default(PENDING)

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  errorMessage      String?
  externalMessageId String?
  retryCount        Int @default(0)
  lastAttemptAt     DateTime?

  createdAt DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@map("campaign_recipients")
}

model CustomerInteraction {
  id String @id @default(uuid())

  companyId     String
  customerId    String
  campaignId    String?
  appointmentId String?
  saleId        String?

  type        InteractionType
  subject     String
  description String?
  metadata    String?

  interactionAt DateTime @default(now())
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([type])
  @@index([campaignId])
  @@index([interactionAt])
  @@map("customer_interactions")
}

model CustomerTask {
  id String @id @default(uuid())

  companyId  String
  customerId String
  assignedTo String

  type     TaskType
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus @default(OPEN)

  sourceType String?
  sourceId   String?

  title       String
  description String?
  dueDate     DateTime?

  completedAt DateTime?
  completedBy String?

  metadata String?

  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("customer_tasks")
}

model CustomerTag {
  id String @id @default(uuid())

  companyId String

  name  String
  color String?

  createdAt DateTime @default(now())

  company    Company                  @relation(fields: [companyId], references: [id])
  assignments CustomerTagAssignment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String @id @default(uuid())
  customerId String
  tagId      String
  createdBy  String?

  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  tag      CustomerTag @relation(fields: [tagId], references: [id])

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@map("customer_tag_assignments")
}

model Customer {
  id String @id @default(uuid())

  companyId String

  name     String
  email    String?
  phone    String?
  phoneNormalized String?
  document String?

  birthDate DateTime?

  notes String?

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company       Company        @relation(fields: [companyId], references: [id])
  appointments  Appointment[]
  serviceOrders ServiceOrder[]
  notifications Notification[]
  sales             Sale[]
  cashbackTxns      CashbackTransaction[]
  loyaltyPointsRef  LoyaltyPoints[]
  tagAssignments    CustomerTagAssignment[]
  campaignReceipts  CampaignRecipient[]
  interactions      CustomerInteraction[]
  tasks             CustomerTask[]
  conversations     Conversation[]

  @@unique([companyId, document])
  @@unique([companyId, phoneNormalized])
  @@index([companyId])
  @@index([name])
  @@index([phone])
  @@index([active])
  @@map("customers")
}

model Professional {
  id String @id @default(uuid())

  companyId String

  name     String
  email    String?
  phone    String?
  document String?

  specialty String?

  commissionRate Decimal? @db.Decimal(5, 2)

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company Company @relation(fields: [companyId], references: [id])

  units          ProfessionalUnit[]
  appointments   Appointment[]
  serviceOrders  ServiceOrder[]
  scheduleBlocks ScheduleBlock[]

  @@unique([companyId, document])
  @@index([companyId])
  @@index([name])
  @@index([active])
  @@map("professionals")
}

model ProfessionalUnit {
  id String @id @default(uuid())

  professionalId String
  unitId         String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])

  @@unique([professionalId, unitId])
  @@index([professionalId])
  @@index([unitId])
  @@map("professional_units")
}

model Service {
  id String @id @default(uuid())

  companyId String

  name        String
  description String?

  durationMinutes Int

  price           Decimal  @db.Decimal(10, 2)
  commissionType  String?
  commissionValue Decimal? @db.Decimal(10, 2)

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company           Company            @relation(fields: [companyId], references: [id])
  appointments      Appointment[]
  serviceOrderItems ServiceOrderItem[]
  saleItems         SaleItem[]

  @@index([companyId])
  @@index([name])
  @@index([active])
  @@map("services")
}

model Appointment {
  id String @id @default(uuid())

  companyId      String
  unitId         String
  customerId     String
  professionalId String
  serviceId      String

  startAt DateTime
  endAt   DateTime

  status AppointmentStatus @default(SCHEDULED)

  notes String?

  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?

  externalCalendarId  String?
  externalProvider    String?

  rescheduledFromId String? @unique
  rescheduledTo     Appointment? @relation("RescheduledAppointments")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company      Company      @relation(fields: [companyId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  service      Service      @relation(fields: [serviceId], references: [id])

  rescheduledFrom Appointment? @relation("RescheduledAppointments", fields: [rescheduledFromId], references: [id])

  serviceOrder ServiceOrder?

  @@index([companyId])
  @@index([unitId])
  @@index([customerId])
  @@index([professionalId])
  @@index([startAt])
  @@index([status])
  @@map("appointments")
}

model ServiceOrder {
  id String @id @default(uuid())

  companyId String
  unitId    String

  appointmentId String? @unique

  customerId     String
  professionalId String

  status ServiceOrderStatus @default(OPEN)

  startedAt  DateTime?
  finishedAt DateTime?

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  couponId String?

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company      Company      @relation(fields: [companyId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  coupon       Coupon?      @relation(fields: [couponId], references: [id])

  items    ServiceOrderItem[]
  payments Payment[]

  sale Sale?

  @@index([companyId])
  @@index([unitId])
  @@index([customerId])
  @@index([professionalId])
  @@index([status])
  @@map("service_orders")
}

model ServiceOrderItem {
  id String @id @default(uuid())

  serviceOrderId String
  serviceId      String?
  productId      String?

  quantity Int @default(1)

  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalPrice     Decimal @db.Decimal(10, 2)

  serviceName String?
  productName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])

  @@index([serviceOrderId])
  @@index([serviceId])
  @@index([productId])
  @@map("service_order_items")
}

model CashRegister {
  id String @id @default(uuid())

  companyId String
  unitId    String

  openedBy String
  closedBy String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingAmount Decimal  @db.Decimal(10, 2)
  closingAmount Decimal? @db.Decimal(10, 2)

  status CashRegisterStatus @default(OPEN)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  transactions CashTransaction[]
  closings     CashClosing[]

  @@index([companyId])
  @@index([unitId])
  @@index([status])
  @@map("cash_registers")
}

model Payment {
  id String @id @default(uuid())

  companyId String
  unitId    String

  serviceOrderId String?
  saleId         String?

  amount Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)

  paidAt     DateTime?
  refundedAt DateTime?

  externalPaymentId String?
  provider          String?
  providerStatus    String?
  paymentUrl        String?
  pixCode           String?

  gatewayTransactionId String?
  gatewayResponse      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])

  transactions CashTransaction[]

  @@index([companyId])
  @@index([unitId])
  @@index([serviceOrderId])
  @@index([saleId])
  @@index([status])
  @@map("payments")
}

model CashTransaction {
  id String @id @default(uuid())

  companyId String
  unitId    String

  cashRegisterId String

  paymentId String?

  type CashTransactionType

  amount Decimal @db.Decimal(10, 2)

  description String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([companyId])
  @@index([unitId])
  @@index([cashRegisterId])
  @@index([paymentId])
  @@map("cash_transactions")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  REFRESH_TOKEN
  PAY
  CANCEL
  CLOSE_CASH
  GENERATE_SALE
  GENERATE_REFUND
}

model AuditLog {
  id String @id @default(uuid())

  companyId String
  userId    String

  action   AuditAction
  entity   String
  entityId String?

  oldData String?
  newData String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id String @id @default(uuid())

  companyId String

  name        String
  description String?

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company Company @relation(fields: [companyId], references: [id])

  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([active])
  @@map("categories")
}

model Product {
  id String @id @default(uuid())

  companyId  String
  categoryId String?

  name    String
  barcode String?

  costPrice Decimal @db.Decimal(10, 2)
  salePrice Decimal @db.Decimal(10, 2)

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company  Company   @relation(fields: [companyId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  stocks        Stock[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  serviceOrderItems ServiceOrderItem[]
  transfers       Transfer[]
  inventoryItems  InventoryItem[]
  stockAlerts     StockAlert[] @relation("ProductStockAlerts")
  saleItems       SaleItem[]

  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([categoryId])
  @@index([name])
  @@index([active])
  @@map("products")
}

model Coupon {
  id String @id @default(uuid())

  companyId String

  code          String
  discountType  DiscountType
  discountValue Decimal @db.Decimal(10, 2)
  minPurchaseValue Decimal? @db.Decimal(10, 2)
  maxUses       Int?
  expiresAt     DateTime?
  active        Boolean @default(true)
  usedCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  serviceOrders ServiceOrder[]
  sales         Sale[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([active])
  @@index([expiresAt])
  @@map("coupons")
}

model Sale {
  id String @id @default(uuid())

  companyId String
  unitId    String
  customerId String?

  serviceOrderId String? @unique

  status     SaleStatus @default(DRAFT)

  subtotal       Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  couponId String?

  notes String?

  createdBy   String
  updatedBy   String?
  cancelledBy String?
  refundedBy  String?

  cancelledAt   DateTime?
  cancelledReason String?
  refundedAt    DateTime?
  refundReason  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  unit     Unit      @relation(fields: [unitId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])

  items            SaleItem[]
  payments         Payment[]
  cashbackTxns     CashbackTransaction[]
  loyaltyPointsRef LoyaltyPoints[]

  @@index([companyId])
  @@index([unitId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sales")
}

model CashbackTransaction {
  id String @id @default(uuid())

  companyId  String
  saleId     String
  customerId String

  amount  Decimal @db.Decimal(10, 2)
  rate    Decimal @db.Decimal(5, 2)
  status  CashbackStatus @default(PENDING)

  expiresAt  DateTime?
  usedAt     DateTime?
  usedInSaleId String?

  createdAt DateTime @default(now())

  company  Company @relation(fields: [companyId], references: [id])
  sale     Sale    @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@map("cashback_transactions")
}

model LoyaltyProgram {
  id String @id @default(uuid())

  companyId String @unique

  name            String
  pointsPerAmount Decimal @db.Decimal(10, 2)
  minAmount       Decimal @default(0) @db.Decimal(10, 2)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("loyalty_programs")
}

model LoyaltyPoints {
  id String @id @default(uuid())

  companyId  String
  customerId String
  saleId     String?

  points      Int
  type        String    // EARNED | REDEEMED | EXPIRED | CANCELLED
  description String?

  createdAt DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@index([companyId])
  @@index([customerId])
  @@index([saleId])
  @@index([type])
  @@map("loyalty_points")
}

model SaleItem {
  id     String @id @default(uuid())
  saleId String

  productId String?
  serviceId String?

  productName    String
  productBarcode String?
  serviceName    String?

  quantity     Decimal @db.Decimal(10, 3)
  unitPrice    Decimal @db.Decimal(10, 2)
  costPrice    Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([serviceId])
  @@map("sale_items")
}

model Stock {
  id String @id @default(uuid())

  companyId String
  unitId    String
  productId String

  quantity Decimal @db.Decimal(10, 3)
  avgCost  Decimal @db.Decimal(10, 2) @default(0)
  minStock Decimal? @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([companyId, unitId, productId])
  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@map("stocks")
}

model StockAlert {
  id String @id @default(uuid())

  companyId String
  unitId    String?
  productId String?

  type    StockAlertType
  message String
  details String?

  resolved  Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  unit    Unit?    @relation("UnitStockAlerts", fields: [unitId], references: [id])
  product Product? @relation("ProductStockAlerts", fields: [productId], references: [id])

  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@index([type])
  @@index([resolved])
  @@index([createdAt])
  @@map("stock_alerts")
}

model StockMovement {
  id String @id @default(uuid())

  companyId String
  unitId    String
  productId String

  type StockMovementType

  quantity  Decimal @db.Decimal(10, 3)
  unitCost  Decimal? @db.Decimal(10, 2)
  totalCost Decimal? @db.Decimal(10, 2)

  balanceBefore Decimal @db.Decimal(10, 3)
  balanceAfter  Decimal @db.Decimal(10, 3)

  avgCostBefore Decimal? @db.Decimal(10, 2)
  avgCostAfter  Decimal? @db.Decimal(10, 2)

  referenceId   String?
  referenceType String?

  description String?
  createdBy   String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([unitId])
  @@index([productId])
  @@index([type])
  @@index([referenceId])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid())
  companyId String

  name     String
  document String?
  email    String?
  phone    String?
  contact  String?
  notes    String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  createdBy String?
  updatedBy String?
  deletedBy String?

  company   Company    @relation(fields: [companyId], references: [id])
  purchases Purchase[]

  @@unique([companyId, document])
  @@index([companyId])
  @@index([active])
  @@index([createdAt])
  @@map("suppliers")
}

model Purchase {
  id        String   @id @default(uuid())
  companyId String
  supplierId String
  unitId    String

  invoiceNumber String?
  status        PurchaseStatus @default(DRAFT)

  totalAmount Decimal @db.Decimal(10, 2)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String?
  updatedBy String?

  company  Company   @relation(fields: [companyId], references: [id])
  supplier Supplier  @relation(fields: [supplierId], references: [id])
  unit     Unit      @relation(fields: [unitId], references: [id])
  items    PurchaseItem[]

  @@index([companyId])
  @@index([supplierId])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String

  quantity  Decimal @db.Decimal(10, 3)
  unitCost  Decimal @db.Decimal(10, 2)
  totalCost Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Transfer {
  id        String         @id @default(uuid())
  companyId String

  fromUnitId String
  toUnitId   String
  productId  String

  quantity Decimal @db.Decimal(10, 3)
  unitCost Decimal @db.Decimal(10, 2)

  status TransferStatus @default(PENDING)

  notes String?

  createdBy   String
  approvedBy  String?
  sentBy      String?
  receivedBy  String?
  cancelledBy String?

  createdAt   DateTime  @default(now())
  approvedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id])
  fromUnit Unit    @relation("transfersFrom", fields: [fromUnitId], references: [id])
  toUnit   Unit    @relation("transfersTo", fields: [toUnitId], references: [id])
  product  Product @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@index([productId])
  @@index([status])
  @@map("transfers")
}

model InventoryCount {
  id        String          @id @default(uuid())
  companyId String
  unitId    String

  status InventoryStatus @default(OPEN)

  notes String?

  createdBy   String
  startedBy   String?
  reviewedBy  String?
  approvedBy  String?
  cancelledBy String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  reviewedAt  DateTime?
  approvedAt  DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  items   InventoryItem[]

  @@unique([companyId, unitId, status], name: "unique_open_inventory")
  @@index([companyId])
  @@index([unitId])
  @@index([status])
  @@map("inventory_counts")
}

model InventoryItem {
  id           String @id @default(uuid())
  inventoryId  String
  productId    String

  systemQuantity  Decimal @db.Decimal(10, 3)
  countedQuantity Decimal @db.Decimal(10, 3)
  difference      Decimal @db.Decimal(10, 3)

  unitCost Decimal @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())

  inventory InventoryCount @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@unique([inventoryId, productId])
  @@index([inventoryId])
  @@index([productId])
  @@map("inventory_items")
}

model FinancialCategory {
  id String @id @default(uuid())

  companyId String

  name String
  type FinancialCategoryType

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  accounts FinancialAccount[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@index([type])
  @@map("financial_categories")
}

model FinancialAccount {
  id String @id @default(uuid())

  companyId  String
  categoryId String

  description String

  type   FinancialAccountType
  status FinancialAccountStatus @default(OPEN)

  amount Decimal @db.Decimal(10, 2)

  dueDate DateTime
  paidAt  DateTime?

  paymentId String?

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  category FinancialCategory  @relation(fields: [categoryId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@map("financial_accounts")
}

model CashClosing {
  id String @id @default(uuid())

  companyId      String
  unitId         String
  cashRegisterId String

  openedAt DateTime
  closedAt DateTime?

  openingAmount Decimal @db.Decimal(10, 2)
  closingAmount Decimal? @db.Decimal(10, 2)
  expectedAmount Decimal? @db.Decimal(10, 2)
  difference     Decimal? @db.Decimal(10, 2)

  closedBy String?

  createdAt DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id])
  unit         Unit         @relation(fields: [unitId], references: [id])
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@index([companyId])
  @@index([unitId])
  @@index([closedAt])
  @@map("cash_closings")
}

model AutomationExecution {
  id String @id @default(uuid())

  eventName    String
  ruleName     String
  sourceModule String
  payload      String?
  status       AutomationExecutionStatus
  error        String?
  durationMs   Int?
  retryCount   Int @default(0)

  executedAt DateTime @default(now())

  @@index([eventName])
  @@index([ruleName])
  @@index([status])
  @@index([executedAt])
  @@map("automation_executions")
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Conversation {
  id String @id @default(uuid())

  companyId  String
  customerId String

  channel  ConversationChannel
  status   ConversationStatus @default(OPEN)
  priority ConversationPriority @default(NORMAL)

  assignedToId String?

  firstResponseAt   DateTime?
  lastAgentMessageAt DateTime?
  lastMessageAt     DateTime?
  assignedAt        DateTime?
  closedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  messages ConversationMessage[]
  notes    ConversationNote[]
  tags     ConversationTag[]

  @@unique([companyId, customerId, channel, status], name: "unique_open_conversation")
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@map("conversations")
}

model ConversationNote {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_notes")
}

model ConversationTag {
  id             String @id @default(uuid())
  conversationId String
  tag            String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tag])
  @@index([conversationId])
  @@map("conversation_tags")
}

model ConversationMessage {
  id String @id @default(uuid())

  conversationId String
  direction      MessageDirection
  content        String
  externalId     String?
  status         MessageStatus @default(SENT)
  metadata       String?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([direction])
  @@index([externalId])
  @@map("conversation_messages")
}

model Integration {
  id String @id @default(uuid())

  companyId String

  type        String
  name        String
  credentials String?
  active      Boolean @default(true)

  provider   String?
  version    String?   @default("v1")
  webhookSecret String?

  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id])
  logs    IntegrationLog[]

  @@index([companyId])
  @@index([type])
  @@index([active])
  @@map("integrations")
}

model IntegrationLog {
  id String @id @default(uuid())

  integrationId String
  eventName     String
  direction     IntegrationLogDirection
  payload       String?
  status        IntegrationLogStatus
  error         String?

  processedAt DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id])

  @@index([integrationId])
  @@index([eventName])
  @@index([direction])
  @@index([status])
  @@map("integration_logs")
}
